# --- secrets: never, under any circumstances ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!**/public*.key
id_rsa
id_ed25519
credentials.json
secrets.json
*.credentials
.netrc

# --- Claude Code local state ------------------------------------------------------------
.claude/settings.local.json
.claude/.cache/

# --- Python -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node --------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*

# --- LaTeX build artifacts ---------------------------------------------------------------
# The .tex source and the .pdf are deliverables and ARE committed; the intermediates are not.
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.lof
*.lot
*.nav
*.snm
*.vrb

# --- OS and editor -------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json

# --- scratch -------------------------------------------------------------------------------
tmp/
scratch/
*.tmp

# NOTE: Reports/ is deliberately NOT ignored. Audit history is a deliverable — it is what
# lets a later audit recognise a returning defect as a regression. See
# config/claude/settings/settings.project.json.
